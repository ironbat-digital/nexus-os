{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexusos.dev/v1alpha2/assistant-handoff.schema.json",
  "title": "Assistant handoff metadata (v1alpha2)",
  "description": "Machine-readable metadata describing the deployment handoff to a coding assistant (Claude / OpenClaw or similar). TARGET-STATE contract. The human-readable SETUP.md is a RENDER of this metadata plus the SetupPlan; SETUP.md is NOT the machine source of truth (the PersonalStack lock is) and MUST NOT contain plaintext secrets. This document references the authoritative artifacts and carries ONLY secret references. The assistant works with a scoped `setup_executor` role and never receives a plaintext secret in its prompt or context (ADR-0005).",
  "x-nexus-contract-version": "v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "nexus.io/v1alpha2" },
    "kind": { "const": "AssistantHandoff" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "generated_at", "assistant", "role"],
      "properties": {
        "instance_id": { "$ref": "https://schemas.nexusos.dev/v1alpha1/common.defs.schema.json#/$defs/InstanceId" },
        "generated_at": { "$ref": "https://schemas.nexusos.dev/v1alpha1/common.defs.schema.json#/$defs/Timestamp" },
        "assistant": { "type": "string", "enum": ["claude", "openclaw", "generic_coding_assistant"] },
        "role": { "const": "setup_executor", "description": "Scoped role; does NOT inherit all owner permissions (ADR-0005)." }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_of_truth", "artifacts", "setup_md", "secret_handling", "boundaries"],
      "properties": {
        "source_of_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "stack_id"],
          "description": "The authoritative machine artifact. The handoff Markdown is explicitly NOT it.",
          "properties": {
            "kind": { "const": "PersonalStack" },
            "ref": { "type": "string", "minLength": 1, "description": "Path/URL to the PersonalStack lock file." },
            "stack_id": { "const": "personal-local-v1" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "description": "The machine artifacts the assistant consumes. No secret values.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["PersonalStack", "Blueprint", "SetupPlan", "DeploymentModality", "EditionDeclaration"] },
              "ref": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "setup_md": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "is_source_of_truth", "contains_plaintext_secrets"],
          "properties": {
            "ref": { "type": "string", "minLength": 1, "description": "Path/URL to the rendered SETUP.md." },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "is_source_of_truth": { "const": false, "description": "SETUP.md is a render, never the machine source of truth." },
            "contains_plaintext_secrets": { "const": false, "description": "SETUP.md never contains plaintext secrets." }
          }
        },
        "secret_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "bundle_ref", "plaintext_in_prompt"],
          "properties": {
            "mode": { "type": "string", "enum": ["oauth", "device_flow", "encrypted_bundle", "vault_reference"], "description": "Preferred acquisition; OAuth/device flow first, manual paste into an encrypted form as last resort." },
            "bundle_ref": { "$ref": "secret-bundle-ref.schema.json" },
            "plaintext_in_prompt": { "const": false, "description": "The assistant never receives a plaintext secret in its prompt/context (ADR-0005)." }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "description": "What the assistant is NOT permitted to do for a Personal bootstrap.",
          "required": ["may_choose_architecture", "may_select_cloud_provider", "may_enable_multi_user", "may_add_non_default_provider"],
          "properties": {
            "may_choose_architecture": { "const": false },
            "may_select_cloud_provider": { "const": false },
            "may_enable_multi_user": { "const": false },
            "may_add_non_default_provider": { "const": false }
          }
        }
      }
    }
  }
}
